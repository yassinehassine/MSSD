{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/mssd-app/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://mssd-backend.onrender.com"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
